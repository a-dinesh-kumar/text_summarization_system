APP_NAME=Text Summarization System API
APP_VERSION=1.0.0
ENVIRONMENT=local

# Choose: bart or flan_t5
SUMMARIZATION_MODEL=bart

HF_HOME=/app/.cache/huggingface
MAX_UPLOAD_SIZE_MB=15
MAX_DOCUMENT_CHARACTERS=500000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_NEW_TOKENS=140
NUM_BEAMS=4
NO_REPEAT_NGRAM_SIZE=3
LENGTH_PENALTY=1.0
MAX_REDUCTION_LEVELS=8
